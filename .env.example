# ---- Gateway (hosted) ----
BRAIN_STORE=github                  # github (hosted) | local (a git checkout)
BRAIN_GITHUB_REPO=owner/agent-brain
BRAIN_GITHUB_TOKEN=                 # fine-grained PAT: only this repo, Contents: read & write
BRAIN_GITHUB_BRANCH=main
BRAIN_PUBLIC_URL=https://brain.example.com
BRAIN_WRITES_PER_MINUTE=120         # per agent; 0 disables the limit
BRAIN_ALLOWED_HOSTS=                # optional DNS-rebinding guard, e.g. brain.example.com
BRAIN_ALLOWED_ORIGINS=

# ---- Local mode (CLI in a checkout) ----
BRAIN_ROOT=                         # default: nearest folder with _registry/customers.yaml
BRAIN_GIT_COMMIT=1                  # commit each write locally (you push)
BRAIN_AGENT_ID=claude-code          # identity the CLI writes as

# ---- Ingestors (GitHub Actions secrets/variables) ----
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_ACCOUNTS=work,personal
GOOGLE_WORK_REFRESH_TOKEN=
GOOGLE_WORK_ADDRESSES=you@example.com
GOOGLE_PERSONAL_REFRESH_TOKEN=
GOOGLE_PERSONAL_ADDRESSES=
BRAIN_GITHUB_INGEST_TOKEN=          # read-only PAT for customer repos (apps synced to GitHub)
BRAIN_INGEST_BACKFILL_DAYS=30
BRAIN_GAPS_WEBHOOK=                 # optional Slack incoming webhook for the daily gaps summary
